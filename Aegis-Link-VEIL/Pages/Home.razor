@layout EmptyLayout
@page "/"

<PageTitle>Aegis Link</PageTitle>

<div class="aegis-root">

    <div class="top-bar">
        <div class="logo-wrap">
            <img src="images/aegis-logo-temp.svg" alt="Aegis Link Logo" />
        </div>
        <div class="app-name">Aegis Link</div>
        <div class="app-sub">End-to-end encrypted relay</div>
    </div>

    <NavLink href="chat" class="cta-btn">
        Establish Secure Connection
    </NavLink>

    <div class="section-label">Saved Contacts</div>

    <div class="contacts-list">
        <p class="no-contacts">No saved contacts yet.</p>
    </div>

    <div class="spacer"></div>

    <nav class="bottom-nav">

        <div class="nav-item">
            <div class="nav-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" />
                </svg>
            </div>
            Messages
        </div>

        <div class="nav-item">
            <div class="nav-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
            </div>
            Encryption
        </div>

        <div class="nav-item">
            <div class="nav-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </div>
            Killswitch
        </div>

        <div class="nav-item">
            <div class="nav-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
                </svg>
            </div>
            Settings
        </div>

    </nav>

</div>
