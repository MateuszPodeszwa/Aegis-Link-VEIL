@page "/chat/{SessionId}"
@layout EmptyLayout
@inject ChatStore ChatStore
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS

<div class="aegis-root">
    <div class="top-bar">
        <button class="back-btn" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
            </svg>
        </button>
        <div class="app-name">@(chatSession?.PartnerName ?? "Aegis Link")</div>
    </div>

    @if (connectionError is not null)
    {
        <div class="connection-banner error-banner">@connectionError</div>
    }
    else if (connectionStatus != "Connected")
    {
        <div class="connection-banner">@connectionStatus</div>
    }

    <div class="messages-container">
        <ul class="messages-list">
            @foreach (var msg in chatSession?.Messages ?? Enumerable.Empty<ChatMessage>())
            {
                var messageClass = msg.From switch
                {
                    MessageSender.Me => "message me",
                    MessageSender.Partner => "message partner",
                    MessageSender.System => "message system",
                    _ => "message"
                };

                <li class="@messageClass">
                    <div class="bubble">
                        @msg.Content
                    </div>
                </li>
            }
        </ul>
    </div>

    <div class="message-input-bar">
        <input @bind="messageInput" @bind:event="oninput" placeholder="Type a message..." class="message-input" />

        <button class="send-btn" @onclick="SendMessage">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
            </svg>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string SessionId { get; set; } = string.Empty;

    private ChatSession? chatSession;
    private HubConnection? hubConnection;
    private string messageInput = "";
    private string connectionStatus = "Connecting...";
    private string? connectionError;

    // Initialize the component and setup the hub connection
    protected override async Task OnInitializedAsync()
    {
        await ChatStore.InitializeAsync();
        chatSession = ChatStore.GetChat(SessionId);

        if (string.IsNullOrWhiteSpace(SessionId) || chatSession == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var client = ClientFactory.CreateClient("WebAPI");
        var hubUrl = new Uri(client.BaseAddress!, "chatHub");

        // Create the hub connection
        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .WithAutomaticReconnect()
            .Build();

        hubConnection.Reconnecting += _ =>
        {
            connectionStatus = "Reconnecting...";
            return InvokeAsync(StateHasChanged);
        };

        hubConnection.Reconnected += _ =>
        {
            connectionStatus = "Connected";
            return InvokeAsync(StateHasChanged);
        };

        // Listen for incoming messages
        hubConnection.On<string>("ReceiveMessage", async (payload) =>
        {
            if (chatSession is null) return;
            await InvokeAsync(async () =>
            {
                var decrypted = await JS.InvokeAsync<string?>(
                    "aegisCrypto.decryptMessage",
                    payload,
                    chatSession.SessionKey);

                var displayText = decrypted ?? "[message could not be decrypted]";
                chatSession.StoreMessage(displayText, MessageSender.Partner);
                await ChatStore.SaveAsync();
                StateHasChanged();
            });
        });

        // Listen for partner join events
        hubConnection.On("UserJoined", async () =>
        {
            if (chatSession is null) return;
            chatSession.StoreMessage("A partner joined the secure session.", MessageSender.System);
            await ChatStore.SaveAsync();
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await hubConnection.StartAsync();
            await JoinSession();
            connectionStatus = "Connected";
        }
        catch (Exception ex)
        {
            connectionError = $"Could not connect to server: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    // Send a join session message to the hub
    private async Task JoinSession()
    {
        if (hubConnection is not null && chatSession is not null)
        {
            await hubConnection.SendAsync("JoinSession", SessionId);
            chatSession.StoreMessage("Secure session established. Waiting for partner...", MessageSender.System);
            await ChatStore.SaveAsync();
        }
    }

    // Send a chat message
    private async Task SendMessage()
    {
        if (hubConnection is not null && chatSession is not null
            && hubConnection.State == HubConnectionState.Connected
            && !string.IsNullOrWhiteSpace(messageInput))
        {
            var plaintext = messageInput;
            var ciphertext = await JS.InvokeAsync<string>(
                "aegisCrypto.encryptMessage",
                plaintext,
                chatSession.SessionKey);

            await hubConnection.SendAsync("SendMessage", SessionId, ciphertext);
            chatSession.StoreMessage(plaintext, MessageSender.Me);
            await ChatStore.SaveAsync();
            messageInput = string.Empty;
        }
    }

    // Dispose hub connection
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/contacts");
    }
}