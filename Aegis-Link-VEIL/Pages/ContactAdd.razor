@page "/contacts/add"
@layout EmptyLayout
@inject ContactService ContactService
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@using AegisLink.Shared
@using System.Net.Http.Json

<div class="aegis-root">

    <div class="top-bar">
        <button @onclick='() => Navigation.NavigateTo("/")' style="background: transparent; border: none; cursor: pointer; color: white;">
            <span class="material-icons">
                arrow_back
            </span>
        </button>
        
        <div class="app-name">
            Create Contact
        </div>
    </div>

    <div class="form-area">

        <!-- Step 1: Enter the ID -->
        <div class="field-group">
            <label class="field-label">Aegis ID</label>
            <input class="aegis-input @(lookupState == LookupState.NotFound ? "input-error" : "")
            @(lookupState == LookupState.Found ? "input-success" : "")"
                   value="@aegisIdInput"
                   @oninput="OnIdInput"
                   placeholder="e.g. A3BK9XYZ"
                   maxlength="8"
                   style="text-transform: uppercase; letter-spacing: 0.2em;" />

            @if (lookupState == LookupState.Looking)
            {
                <div class="field-hint">Looking up ID...</div>
            }
            else if (lookupState == LookupState.NotFound)
            {
                <div class="field-hint error">That Aegis ID doesn't exist.</div>
            }
            else if (lookupState == LookupState.AlreadyAdded)
            {
                <div class="field-hint error">You already have this contact saved.</div>
            }
            else if (lookupState == LookupState.IsSelf)
            {
                <div class="field-hint error">That's your own ID.</div>
            }
            else if (lookupState == LookupState.Found)
            {
                <div class="field-hint success">ID verified.</div>
            }
        </div>

        <!-- Step 2: Fill in details — only shown once ID is verified -->
        @if (lookupState == LookupState.Found)
        {
            <div class="field-group">
                <label class="field-label">Nickname <span class="required">*</span></label>
                <input
                    class="aegis-input"
                    @bind="nickname"
                    @bind:event="oninput"
                    placeholder="What do you call them?"
                    maxlength="32" />
            </div>

            <div class="field-group">
                <label class="field-label">Note</label>
                <textarea
                    class="aegis-input aegis-textarea"
                    @bind="note"
                    @bind:event="oninput"
                    placeholder="Optional note about this contact..."
                    maxlength="200" />
                <div class="char-count">@note.Length / 200</div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-text">@errorMessage</div>
            }

            <button class="cta-btn"
                    @onclick="SaveContact"
                    disabled="@(string.IsNullOrWhiteSpace(nickname) || isSaving)">
                @(isSaving ? "Saving..." : "Save Contact")
            </button>
        }
    </div>
</div>

@code {
    private enum LookupState { Idle, Looking, Found, NotFound, AlreadyAdded, IsSelf }

    private string aegisIdInput = string.Empty;
    private string foundPublicKey = string.Empty;
    private string nickname = string.Empty;
    private string note = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSaving = false;
    private LookupState lookupState = LookupState.Idle;

    // Stored identity so we can check if the typed ID is the user's own
    private string myAegisId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var stored = await JS.InvokeAsync<StoredIdentity?>("aegisCrypto.loadIdentity");
        if (stored is not null)
            myAegisId = stored.AegisId;
    }

    private async Task OnIdInput(ChangeEventArgs e)
    {
        SetInput((e.Value?.ToString() ?? string.Empty).ToUpperInvariant());

        // Only look up once we have exactly 8 characters
        if (aegisIdInput.Length != 8) return;

        // Check it's not their own ID
        if (IsSelfId(aegisIdInput)) return;

        // Check if already saved
        if (await HandleAlreadyExists(aegisIdInput)) return;

        // Look up the ID on the server
        await LookupIdentityAsync(aegisIdInput);
    }

    private void SetInput(string value)
    {
        aegisIdInput = value;
        // Reset state when the input changes
        lookupState = LookupState.Idle;
        foundPublicKey = string.Empty;
    }

    private bool IsSelfId(string value)
    {
        if (value != myAegisId) return false;

        lookupState = LookupState.IsSelf;
        return true;
    }

    private async Task<bool> HandleAlreadyExists(string value)
    {
        if (!await ContactService.ExistsAsync(value))
            return false;

        lookupState = LookupState.AlreadyAdded;
        return true;
    }

    private async Task LookupIdentityAsync(string value)
    {
        lookupState = LookupState.Looking;
        StateHasChanged();

        try
        {
            var client = ClientFactory.CreateClient("WebAPI");
            var response = await client.GetAsync($"identity/lookup/{value}");

            var result = await HandleLookupResponse(response, value);

            if (result)
            {
                lookupState = LookupState.Found;
            }
        }
        catch
        {
            lookupState = LookupState.NotFound;
        }
    }

    private async Task<bool> HandleLookupResponse(HttpResponseMessage response, string expectedId)
    {
        if (!response.IsSuccessStatusCode)
        {
            lookupState = LookupState.NotFound;
            return false;
        }

        var result = await response.Content.ReadFromJsonAsync<UserKeyGetResult>();
        if (result is null)
        {
            lookupState = LookupState.NotFound;
            return false;
        }

        // Client-side verification: re-derive the ID from the returned
        // public key and confirm it matches what we asked for
        // This ensures the server hasn't given us a wrong key
        var derivedId = await JS.InvokeAsync<string>(
            "aegisCrypto.createAegisId",
            result.PublicKey
        );

        if (derivedId != expectedId)
        {
            lookupState = LookupState.NotFound;
            errorMessage = "Key verification failed.";
            return false;
        }

        foundPublicKey = result.PublicKey;
        return true;
    }

    private async Task SaveContact()
    {
        if (string.IsNullOrWhiteSpace(nickname))
            return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var contact = await BuildContactAsync();

            await ContactService.SaveAsync(contact);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<Contact> BuildContactAsync()
    {
        var colour = await ContactService.GetColourAsync(aegisIdInput);

        return new Contact
        {
            AegisId = aegisIdInput,
            PublicKey = foundPublicKey,
            Nickname = nickname.Trim(),
            Note = note.Trim(),
            Colour = colour
        };
    }

    private record StoredIdentity(string AegisId, string PublicKey, string SecretKey);
}