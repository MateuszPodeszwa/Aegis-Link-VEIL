@page "/not-found"
@layout EmptyLayout
@inject NavigationManager Navigation

<div class="aegis-root">
    <div class="notfound-container">
        <h3 class="notfound-title">Page Not Found</h3>

        <p class="notfound-text">
            Sorry, there's nothing at this address.
        </p>

        <button class="notfound-btn" @onclick='() => Navigation.NavigateTo("/")'>
            Go Home
        </button>
    </div>
</div>